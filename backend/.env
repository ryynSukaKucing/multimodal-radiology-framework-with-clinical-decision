# Salin file ini menjadi ".env" lalu sesuaikan nilainya.

# Kunci rahasia untuk menandatangani token JWT. GANTI dengan string acak yang panjang!
SECRET_KEY=ganti-dengan-kunci-rahasia-yang-sangat-panjang-dan-acak
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Akun admin default yang dibuat otomatis saat pertama kali server dijalankan
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULLNAME=Administrator

# URL endpoint router AI (9Router / kompatibel OpenAI chat completions)
NINEROUTER_URL=http://localhost:20128/v1/chat/completions

# (Opsional) API key router. Jika diisi, kolom "API" di sidebar otomatis hilang
# dan semua pemindaian langsung bisa dipakai tanpa memasukkan key di browser.
NINEROUTER_API_KEY=
# Isi true bila router lokal Anda tidak memerlukan API key sama sekali (kolom API juga disembunyikan).
NINEROUTER_NO_AUTH=false

# Lokasi database SQLite
DATABASE_URL=sqlite:///./radiology.db

# Folder penyimpanan berkas citra medis yang diunggah
UPLOAD_DIR=./uploads

# Lintasan kedua: lokalisasi temuan yang tidak berkotak + pengukuran CTR (kardiomegali). true = aktif (panggilan model ketiga per citra; bawaan false agar alur tetap deteksi + segmentasi saja).
GROUNDING_PASS=false

# Alur dua panggilan: (1) deteksi objek, (2) segmentasi lewat tombol "Segmentasi". Batas token keluaran per panggilan (minimal 8000, nilai lebih kecil otomatis dinaikkan).
# Model "berpikir" (lihat AI_THINKING_MARKERS) memakai nilai *_THINKING.
DETECT_MAX_TOKENS=8000
DETECT_MAX_TOKENS_THINKING=16000
SEGMENT_MAX_TOKENS=8000
SEGMENT_MAX_TOKENS_THINKING=16000
